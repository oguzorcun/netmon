<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.netmon.reportserver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>REPLACE_WITH_HOME/netmon/report_server.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Keep the local report server alive (it only listens on 127.0.0.1) -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/netmon.server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/netmon.server.err.log</string>
</dict>
</plist>
